PORT=3000
NODE_ENV=development

# =====================================================
# DATABASE (PostgreSQL + pgvector)
# =====================================================
# Local PostgreSQL: postgresql://mahabur:YOUR_PASSWORD@localhost:5432/ai_engineering
DATABASE_URL=postgresql://mahabur:YOUR_PASSWORD@localhost:5432/ai_engineering

# =====================================================
# OLLAMA (Local LLM Runtime)
# =====================================================
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Embedding model for vector generation
# Must be an embedding model (not a chat model!)
# Examples: nomic-embed-text, all-minilm:l6-v2
EMBEDDING_MODEL=nomic-embed-text
